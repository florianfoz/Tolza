{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "workspace creation",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${command:cmake.launchTargetDirectory}",
            "args": [
                "new",
                "workspace",
                "~",
                "--name",
                "test",
                "-f"
            ],
            "preLaunchTask": "CMake: Build"
        },
        {
            "name": "profile creation",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${command:cmake.launchTargetDirectory}",
            "args": [
                "new",
                "profile",
                "${workspaceFolder}/../../tolza-workspace/profile",
                "--name",
                "template"
            ],
            "preLaunchTask": "CMake: Build"
        },
        {
            "name": "manifest creation",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${command:cmake.launchTargetDirectory}",
            "args": [
                "new",
                "manifest",
                "~",
                "--name",
                "test"
            ],
            "preLaunchTask": "CMake: Build"
        },
        {
            "name": "audit",
